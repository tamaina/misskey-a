{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"rootDir": "../features",
		"outDir": "./built/contracts",
		"types": [],
		"removeComments": false
	},
	"include": [
		"../features/api/shared/api-routing.ts",
		"../features/*/contract/**/*.ts",
		"../features/**/*.contract.ts",
		"../features/**/*.schema.ts"
	],
	"exclude": []
}
