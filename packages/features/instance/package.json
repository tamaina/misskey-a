{
  "name": "@misskey-a/instance",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "exports": {
    "./contract": { "types": "./built/contract/index.d.ts", "import": "./built/contract/index.js" },
    "./backend": { "types": "./built/backend/index.d.ts", "import": "./built/backend/index.js" }
