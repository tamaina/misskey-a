{
	"$schema": "https://json.schemastore.org/tsconfig",
	"compilerOptions": {
		"target": "ES2022",
		"module": "esnext",
		"moduleResolution": "bundler",
		"declaration": true,
		"declarationMap": true,
		"sourceMap": false,
		"outDir": "./js-built",
		"removeComments": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"strict": true,
		"strictFunctionTypes": true,
		"strictNullChecks": true,
		"experimentalDecorators": true,
		"noImplicitReturns": true,
		"esModuleInterop": true,
		"verbatimModuleSyntax": true,
		"rootDir": "..",
		"paths": {
			"@/*": [
				"./*"
			],
			"@@/*": [
				"./*"
			],
			"@features/*": [
				"../features/*/index.ts",
				"../features/*"
			],
			"i18n": [
				"./node_modules/i18n"
			],
			"vue": [
				"./node_modules/vue"
			],
			"misskey-js": [
				"./node_modules/misskey-js"
			],
			"json5": [
				"./node_modules/json5"
			],
			"tinycolor2": [
				"./node_modules/@types/tinycolor2"
			],
			"shiki/themes": [
				"./node_modules/shiki/dist/themes.d.mts"
			],
			"@misskey-dev/emoji-data/emojilist.json": [
				"./node_modules/@misskey-dev/emoji-data/built/emojilist.json"
			]
		},
		"typeRoots": [
			"./@types",
			"./node_modules/@types"
		],
		"lib": [
			"esnext",
			"dom"
		]
	},
	"include": [
		"@types/**/*.ts",
		"../features/*/frontend/shared/**/*.ts"
	],
	"exclude": [
		"node_modules",
		"test/**/*"
	]
}
