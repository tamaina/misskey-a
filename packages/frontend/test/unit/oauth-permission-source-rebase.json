			{
				"start": 733,
				"end": 1048,
				"current": "\t\t\t<MkPermissionSelect v-model=\"selectedPermissions\" :permissions=\"Misskey.permissions\" :administrator=\"!!iAmAdmin\"\n\t\t\t\t:labels=\"copyLocaleDictionary($locale.sfc.permissionsLabels)\" :disableAllText=\"$locale.sfc.disableAll\" :enableAllText=\"$locale.sfc.enableAll\" :adminPermissionText=\"$locale.sfc.adminPermission\"/>\n",
				"baseline": "\t\t\t<div class=\"_buttons\">\n\t\t\t\t<MkButton inline @click=\"disableAll\">{{ $locale.sfc.disableAll }}</MkButton>\n\t\t\t\t<MkButton inline @click=\"enableAll\">{{ $locale.sfc.enableAll }}</MkButton>\n\t\t\t</div>\n\t\t\t<div class=\"_gaps_s\">\n\t\t\t\t<MkSwitch v-for=\"kind in Object.keys(permissionSwitches)\" :key=\"kind\" v-model=\"permissionSwitches[kind as keyof typeof permissionSwitches]\">{{ copyLocaleDictionary($locale.sfc.permissionsLabels)[kind as keyof typeof permissionSwitches] }}</MkSwitch>\n\t\t\t</div>\n\t\t\t<div v-if=\"iAmAdmin\" :class=\"$style.adminPermissions\">\n\t\t\t\t<div :class=\"$style.adminPermissionsHeader\"><b>{{ $locale.sfc.adminPermission }}</b></div>\n\t\t\t\t<div class=\"_gaps_s\">\n\t\t\t\t\t<MkSwitch v-for=\"kind in Object.keys(permissionSwitchesForAdmin)\" :key=\"kind\" v-model=\"permissionSwitchesForAdmin[kind as keyof typeof permissionSwitchesForAdmin]\">{{ copyLocaleDictionary($locale.sfc.permissionsLabels)[kind as keyof typeof permissionSwitchesForAdmin] }}</MkSwitch>\n\t\t\t\t</div>\n\t\t\t</div>\n"
			},
			{
				"start": 1270,
				"end": 1329,
				"current": "import MkPermissionSelect from './MkPermissionSelect.vue';\n",
				"baseline": "import MkSwitch from '@features/ui/frontend/components/MkSwitch.vue';\nimport MkButton from '@features/ui/frontend/components/MkButton.vue';\n"
			},
			{
				"start": 2048,
				"end": 2048,
				"current": "",
				"baseline": "const defaultPermissions = Misskey.permissions.filter(p => !p.startsWith('read:admin') && !p.startsWith('write:admin'));\nconst adminPermissions = Misskey.permissions.filter(p => p.startsWith('read:admin') || p.startsWith('write:admin'));\n\n"
			},
			{
				"start": 2126,
				"end": 2232,
				"current": "const selectedPermissions = ref<string[]>(props.initialPermissions ? [...props.initialPermissions] : []);\n",
				"baseline": "const permissionSwitches = ref({} as Record<(typeof Misskey.permissions)[number], boolean>);\nconst permissionSwitchesForAdmin = ref({} as Record<(typeof Misskey.permissions)[number], boolean>);\n\nif (props.initialPermissions) {\n\tfor (const kind of props.initialPermissions) {\n\t\tpermissionSwitches.value[kind] = true;\n\t}\n} else {\n\tfor (const kind of defaultPermissions) {\n\t\tpermissionSwitches.value[kind] = false;\n\t}\n\n\tif (iAmAdmin) {\n\t\tfor (const kind of adminPermissions) {\n\t\t\tpermissionSwitchesForAdmin.value[kind] = false;\n\t\t}\n\t}\n}\n"
			},
			{
				"start": 2291,
				"end": 2333,
				"current": "\t\tpermissions: selectedPermissions.value,\n",
				"baseline": "\t\tpermissions: [\n\t\t\t...Object.keys(permissionSwitches.value).filter(p => permissionSwitches.value[p as (typeof Misskey.permissions)[number]]),\n\t\t\t...(iAmAdmin ? Object.keys(permissionSwitchesForAdmin.value).filter(p => permissionSwitchesForAdmin.value[p as (typeof Misskey.permissions)[number]]) : []),\n\t\t],\n"
			},
			{
				"start": 2365,
				"end": 2365,
				"current": "",
				"baseline": "function disableAll(): void {\n\tfor (const p in permissionSwitches.value) {\n\t\tpermissionSwitches.value[p as (typeof Misskey.permissions)[number]] = false;\n\t}\n\tif (iAmAdmin) {\n\t\tfor (const p in permissionSwitchesForAdmin.value) {\n\t\t\tpermissionSwitchesForAdmin.value[p as (typeof Misskey.permissions)[number]] = false;\n\t\t}\n\t}\n}\n\nfunction enableAll(): void {\n\tfor (const p in permissionSwitches.value) {\n\t\tpermissionSwitches.value[p as (typeof Misskey.permissions)[number]] = true;\n\t}\n\tif (iAmAdmin) {\n\t\tfor (const p in permissionSwitchesForAdmin.value) {\n\t\t\tpermissionSwitchesForAdmin.value[p as (typeof Misskey.permissions)[number]] = true;\n\t\t}\n\t}\n}\n"
			},
