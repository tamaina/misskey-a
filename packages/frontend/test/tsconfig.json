{
	"extends": "../tsconfig.json",
	"compilerOptions": {
		"noUnusedLocals": true,
		"sourceMap": true
	},
	"compileOnSave": false,
	"include": [
		"./**/*.ts",
		"./**/*.vue",
		"../src/**/*.ts",
		"../src/**/*.vue",
		"../vue-shims.d.ts",
		"../@types/**/*.d.ts",
		"../../features/*/frontend/**/*.ts",
		"../../features/*/frontend/**/*.vue"
	],
	"exclude": [
		"../../features/drive/frontend/workers/**/*.ts",
		"../../features/*/frontend/**/*.stories.ts",
		"../../features/*/frontend/**/*.stories.impl.ts",
		"../../features/*/frontend/**/*.msw.ts"
	]
}
