{
	"compilerOptions": {
		"allowJs": true,
		"noEmitOnError": false,
		"noImplicitAny": true,
		"noImplicitReturns": true,
		"noUnusedParameters": false,
		"noUnusedLocals": false,
		"noFallthroughCasesInSwitch": true,
		"declaration": false,
		"sourceMap": false,
		"target": "ES2022",
		"module": "esnext",
		"moduleResolution": "Bundler",
		"removeComments": false,
		"noLib": false,
		"strict": true,
		"strictNullChecks": true,
		"experimentalDecorators": true,
		"resolveJsonModule": true,
		"allowSyntheticDefaultImports": true,
		"isolatedModules": true,
		"useDefineForClassFields": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"paths": {
			"vue": ["./node_modules/vue"],
			"vitest": ["./node_modules/vitest"],
			"i18n": ["./node_modules/i18n"],
			"@/*": ["./src/*"],
			"@@/*": ["../frontend-shared/*"],
			"@features/*": ["../features/*/index.ts"]
		},
		"typeRoots": [
			"./@types",
			"./node_modules/@types",
			"./node_modules/@vue-macros",
			"./node_modules"
		],
		"types": [
			"vite/client",
			"vite-plugin-glsl/ext",
			"vitest/importMeta",
		],
		"lib": [
			"esnext",
			"dom",
			"dom.iterable"
		],
		"jsx": "preserve"
	},
	"vueCompilerOptions": {
		"plugins": [{ "name": "vite-vue-internationalization/volar", "primaryLocale": "ja-JP" }]
	},
	"compileOnSave": false,
	"include": [
		"./src/**/*.ts",
		"./src/**/*.vue",
		"./test/**/*.ts",
		"./test/**/*.vue",
		"./@types/**/*.ts",
		"../features/*/frontend/**/*.ts",
		"../features/*/frontend/**/*.vue",
		"../features/*/shared/**/*.ts"
	],
	"exclude": [
		"./src/**/*.stories.ts"
	]
}
