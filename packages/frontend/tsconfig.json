{
	"compilerOptions": {
		"allowJs": true,
		"noEmitOnError": false,
		"noImplicitAny": true,
		"noImplicitReturns": true,
		"noUnusedParameters": false,
		"noUnusedLocals": false,
		"noFallthroughCasesInSwitch": true,
		"declaration": false,
		"sourceMap": false,
		"target": "ES2022",
		"module": "esnext",
		"moduleResolution": "Bundler",
		"removeComments": false,
		"noLib": false,
		"strict": true,
		"strictNullChecks": true,
		"experimentalDecorators": true,
		"resolveJsonModule": true,
		"allowSyntheticDefaultImports": true,
		"isolatedModules": true,
		"useDefineForClassFields": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"paths": {
			"vue": ["./node_modules/vue"],
			"@storybook/vue3": ["./node_modules/@storybook/vue3/dist/index.d.ts"],
			"storybook/actions": ["./node_modules/storybook/dist/actions/index.d.ts"],
			"@syuilo/aiscript": ["./node_modules/@syuilo/aiscript/built/dts/index.d.ts"],
			"@syuilo/aiscript/*": ["./node_modules/@syuilo/aiscript/built/dts/*"],
			"@syuilo/aiscript-0-19-0": ["./node_modules/@syuilo/aiscript-0-19-0/built/dts/index.d.ts"],
			"@misskey-dev/emoji-data/emojilist.json": ["./node_modules/@misskey-dev/emoji-data/built/emojilist.json"],
			"@misskey-dev/emoji-data/indexes/*.json": ["./node_modules/@misskey-dev/emoji-data/built/indexes/*.json"],
			"shiki/core": ["./node_modules/shiki/dist/core.d.mts"],
			"shiki/langs": ["./node_modules/shiki/dist/langs.d.mts"],
			"shiki/themes": ["./node_modules/shiki/dist/themes.d.mts"],
			"shiki/engine/javascript": ["./node_modules/shiki/dist/engine-javascript.d.mts"],
			"shiki/*": ["./node_modules/shiki/dist/*"],
			"aiscript-vscode/*": ["./node_modules/aiscript-vscode/*"],
			"misskey-js/*": ["./node_modules/misskey-js/built/*"],
			"chartjs-adapter-date-fns": ["./node_modules/chartjs-adapter-date-fns/dist/chartjs-adapter-date-fns.esm.js"],
			"vitest": ["./node_modules/vitest"],
			"i18n": ["./node_modules/i18n"],
			"@/*": ["./src/*"],
			"@@/*": ["../frontend-shared/*"],
			"@features/*": ["../features/*/index.ts", "../features/*"]
		},
		"typeRoots": [
			"./@types",
			"./node_modules/@types",
			"./node_modules/@vue-macros",
			"./node_modules"
		],
		"types": [
			"vite/client",
			"vite-plugin-glsl/ext",
			"vitest/importMeta",
		],
		"lib": [
			"esnext",
			"dom",
			"dom.iterable"
		],
		"jsx": "preserve"
	},
	"vueCompilerOptions": {
		"plugins": [{ "name": "vite-vue-internationalization/volar", "primaryLocale": "ja-JP" }]
	},
	"compileOnSave": false,
	"include": [
		"./src/**/*.ts",
		"./src/**/*.vue",
		"./test/**/*.ts",
		"./test/**/*.vue",
		"./@types/**/*.ts",
		"../features/*/frontend/**/*.ts",
		"../features/*/frontend/**/*.vue",
		"../features/*/shared/**/*.ts"
	],
	"exclude": [
		"./src/**/*.stories.ts",
		"../features/*/frontend/**/*.stories.ts",
		"../features/media/frontend/workers/**/*.ts"
	]
}
