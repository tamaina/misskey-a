+/*
+ * SPDX-FileCopyrightText: syuilo and misskey-project
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+import ts from 'typescript';
+
+/** Experiment-only interpreter: no executable input, calls, or state variables. */
+export function staticExpression(expr: string, scope: unknown): unknown {
+	const file = ts.createSourceFile('search-expression.ts', `const value = (${expr});`, ts.ScriptTarget.Latest, true);
+	if (ts.transpileModule(`const value = (${expr});`, { reportDiagnostics: true, compilerOptions: { target: ts.ScriptTarget.ESNext, module: ts.ModuleKind.ESNext } }).diagnostics?.some(diagnostic => diagnostic.category === ts.DiagnosticCategory.Error)) throw new Error(`Invalid search expression: ${expr}`);
+	const statement = file.statements[0];
+	if (!ts.isVariableStatement(statement) || file.statements.length !== 1) throw new Error(`Invalid search expression: ${expr}`);
+	const visit = (node: ts.Expression): unknown => {
+		if (ts.isParenthesizedExpression(node)) return visit(node.expression);
+		if (ts.isStringLiteral(node) || ts.isNoSubstitutionTemplateLiteral(node)) return node.text;
+		if (ts.isNumericLiteral(node)) return Number(node.text);
+		if (node.kind === ts.SyntaxKind.TrueKeyword) return true;
+		if (node.kind === ts.SyntaxKind.FalseKeyword) return false;
+		if (node.kind === ts.SyntaxKind.NullKeyword) return null;
+		if (ts.isIdentifier(node) && node.text === '$locale') return scope;
+		if (ts.isArrayLiteralExpression(node)) return node.elements.map(item => visit(item));
+		if (ts.isPropertyAccessExpression(node)) return member(visit(node.expression), node.name.text);
+		if (ts.isElementAccessExpression(node) && ts.isStringLiteral(node.argumentExpression)) return member(visit(node.expression), node.argumentExpression.text);
+		throw new Error(`Unsupported dynamic search expression: ${expr}`);
+	};
+
+	function member(value: unknown, key: string): unknown {
+		if (['__proto__', 'constructor', 'prototype'].includes(key) || value === null || (typeof value !== 'object' && typeof value !== 'function')) throw new Error(`Invalid search member: ${expr}`);
+		return Reflect.get(value, key);
+	}
+
+	return visit(statement.declarationList.declarations[0].initializer!);
+}
