+/*
+ * SPDX-FileCopyrightText: syuilo and misskey-project
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+import type { Manifest } from 'vite';
+/** Observed VVI 1.1.3 output contract, not a public SSR API guarantee. */
+export function experimentManifest(manifest: Manifest, canonical: string) {
+	const entry = manifest[canonical];
+	if (!entry?.isEntry) throw new Error(`Missing canonical application entry ${canonical}`);
+
+	function checkedFile(value: unknown): string {
+		if (typeof value !== 'string' || !/^[A-Za-z0-9_-]+\/[A-Za-z0-9_.-]+\.js$/.test(value)) throw new Error(`Invalid manifest script path ${String(value)}`);
+		return value;
+	}
+
+	function metadata(chunk: unknown): { primaryLocale: string; locales: Record<string, string> } | null {
+		const record = chunk as Record<string, unknown>;
+		// Existing SSR has no SRI attribute; refuse unhandled integrity rather than discard it.
+		if ('integrity' in record) throw new Error('Manifest integrity requires an explicit SRI adapter');
+		if (record.internationalization === undefined) return null;
+		const meta = record.internationalization as Record<string, unknown>;
+		if (!meta || typeof meta !== 'object' || Array.isArray(meta) || Object.keys(meta).some(key => !['primaryLocale', 'locales'].includes(key)) || typeof meta.primaryLocale !== 'string' || !meta.locales || typeof meta.locales !== 'object' || Array.isArray(meta.locales)) throw new Error('Unsupported VVI 1.1.3 internationalization metadata');
+		const locales = meta.locales as Record<string, string>;
+		if (!Object.hasOwn(locales, meta.primaryLocale) || !Object.keys(locales).length) throw new Error('Missing primary locale manifest path');
+		for (const file of Object.values(locales)) checkedFile(file);
+		return { primaryLocale: meta.primaryLocale, locales };
+	}
+
+	const entryMeta = metadata(entry);
+	if (!entryMeta) throw new Error('Experiment requires explicit localized application metadata');
+	const result: Record<string, { entryJs: string; css: string[]; modulePreloads: string[] }> = {};
+	for (const lang of Object.keys(entryMeta.locales)) {
+		const selected = (chunk: typeof entry) => {
+			const meta = metadata(chunk);
+			return checkedFile(meta ? meta.locales[lang] ?? meta.locales[meta.primaryLocale] : chunk.file);
+		};
+		const seen = new Set<string>(), css = new Set<string>(), preloads = new Set<string>();
+
+		function visit(chunk:typeof entry, top = false) {
+			if (chunk.css !== undefined) {
+				if (!Array.isArray(chunk.css) || chunk.css.some(file => typeof file !== 'string' || !/^assets\/[A-Za-z0-9_.-]+\.css$/.test(file))) throw new Error('Invalid CSS manifest paths');
+				chunk.css.forEach(file => css.add(file));
+			}
+			if (chunk.imports !== undefined) {
+				if (!Array.isArray(chunk.imports) || chunk.imports.some(id => typeof id !== 'string')) throw new Error('Invalid dependency manifest keys');
+				for (const key of chunk.imports) {
+					if (seen.has(key)) continue; seen.add(key);
+					const dependency = manifest[key]; if (!dependency) throw new Error(`Missing dependency ${key}`);
+					if (top)preloads.add(selected(dependency));
+					visit(dependency);
+				}
+			}
+		}
+
+		visit(entry, true);
+		result[lang] = { entryJs: selected(entry), css: [...css], modulePreloads: [...preloads] };
+	}
+	return { primaryLocale: entryMeta.primaryLocale, locales: result };
+}
